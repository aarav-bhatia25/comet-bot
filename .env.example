# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Required for LLM answers and embeddings
OPENAI_API_KEY=your-openai-api-key-here

# Optional: override the chat model (default set in config)
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional: override the embedding model (default set in config)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
